# ============================================================
# WMS-Lite Production Environment Variables — Example Template
# ============================================================
# 이 파일은 예시 템플릿입니다. 실제 값으로 채운 뒤 파일명을
# .env.prod 으로 바꾸어 사용하세요.
# ============================================================

# Spring Profile (운영 환경은 반드시 prod 유지)
SPRING_PROFILES_ACTIVE=prod

# ── DB 연결 (Neon.tech PostgreSQL) ──────────────────────────
# Neon 콘솔 > 프로젝트 선택 > Connection string 에서 복사
DB_URL=jdbc:postgresql://<neon-host>/<dbname>?sslmode=require
DB_USERNAME=<neon_role_name>
DB_PASSWORD=<neon_role_password>

# 첫 포트폴리오 배포/빈 Neon DB는 update 권장.
# 스키마가 안정화된 뒤에는 validate로 바꾸어 검증 모드로 운영하세요.
JPA_DDL_AUTO=update

# ── JWT 설정 ────────────────────────────────────────────────
# 최소 32자 이상의 랜덤 문자열 사용 (예: openssl rand -hex 32)
JWT_SECRET=<replace-with-32-chars-or-more-random-secret>

# Access Token 유효 시간 (초) — 기본 1시간
JWT_ACCESS_TOKEN_VALIDITY_SECONDS=3600

# Refresh Token 유효 시간 (초) — 기본 14일
JWT_REFRESH_TOKEN_VALIDITY_SECONDS=1209600

# ── CORS ────────────────────────────────────────────────────
# 실제 배포된 프론트엔드 도메인으로 변경
# 여러 개는 콤마(,)로 구분
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
